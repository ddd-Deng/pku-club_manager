# URL 中的用户名、密码需 URL 编码。先由管理员创建 campus_club 数据库。
DATABASE_URL=mysql+pymysql://campus_club:CHANGE_ME@127.0.0.1:3306/campus_club?charset=utf8mb4
# 使用 secrets.token_urlsafe(48) 生成；必须至少 32 字符，不使用示例值。
TOKEN_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FINISH_INTERVAL_SECONDS=60
